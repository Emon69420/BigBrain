# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/bigbrain
SECRET_KEY=change-me-to-random-32-chars
# Comma-separated frontend origins allowed for cross-site cookies (ngrok URLs go here when exposing backend)
FRONTEND_ORIGINS=http://localhost:3000
# Local embeddings (no API needed) — bge-m3 via Sentence Transformers
EMBED_MODEL=BAAI/bge-m3
